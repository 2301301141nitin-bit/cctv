# Real-time CCTV Intelligence Platform Config
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Sampling rate (process 1 out of every N frames)
DEFAULT_FRAME_SAMPLING=3

# YOLO Model path (will be downloaded automatically if not present)
MODEL_NAME=yolov8n.pt

# Firebase Integration
FIREBASE_ENABLED=False
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
